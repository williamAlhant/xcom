# xcom test VM: Debian + sshd + Xvfb + test applications.
#
# This is the M1/M2 acceptance environment and a stand-in for a real target
# VM: it runs the *static* xcomd build (mounted in at /usr/local/bin/xcomd),
# proving the shipping artifact works on a stock Debian userland.
#
# Build:  scripts/testvm.sh up
# Run:    scripts/testvm.sh up   (also builds and starts the container)
FROM debian:bookworm-slim

# X11 apps (xterm, shells) need a UTF-8 locale to convert non-ASCII keysyms.
ENV LANG=C.UTF-8

# kitty is an OpenGL terminal kept for damage/full-window-frame tests (it
# blinks its cursor by default). Xvfb has no GPU, so Mesa's llvmpipe provides
# the GL context; mesa-utils' glxinfo makes a startup failure diagnosable.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        openssh-server \
        xauth xvfb xfonts-base fonts-dejavu-core \
        x11-apps xterm gtk-3-examples \
        kitty libgl1-mesa-dri mesa-utils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && ssh-keygen -A

RUN useradd -m -s /bin/bash xcom \
    && mkdir -p /home/xcom/.ssh \
    && chmod 700 /home/xcom/.ssh

# Test client key (generated by scripts/testvm.sh into the build context).
COPY authorized_keys /home/xcom/.ssh/authorized_keys
RUN chmod 600 /home/xcom/.ssh/authorized_keys \
    && chown -R xcom:xcom /home/xcom/.ssh

# Unprivileged port: rootless podman cannot bind :22 on the host network.
RUN printf 'Port 2222\nPermitRootLogin no\nPasswordAuthentication no\n' \
        > /etc/ssh/sshd_config.d/xcom.conf

EXPOSE 2222
CMD ["/usr/sbin/sshd", "-D", "-e"]
